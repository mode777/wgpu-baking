{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "lib": ["ES2022", "DOM", "DOM.Iterable", "WebWorker"],
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "noEmit": true,
    "skipLibCheck": true,
    "types": ["vite/client", "node"],
    "paths": { "lightbaker-web": ["../crates/lightbaker-web/pkg/lightbaker_web.d.ts"] }
  },
  "include": ["src", "test", "vite.config.ts"]
}
